<view class="page"><view class="state" wx:if="{{loading}}">加载中…</view><view class="state" wx:elif="{{error}}">{{error}}<button bindtap="load">重试</button></view><block wx:elif="{{item}}"><view class="meta">{{item.source_label}}</view><view class="title">{{item.title}}</view><view class="card"><view class="body">{{item.long}}</view><view class="tag" wx:for="{{item.takeaways}}" wx:key="*this">{{item}}</view><view class="meta">{{item.summary_provider === 'llm' ? 'AI 辅助摘要，请以原文为准' : '基于原文摘录整理'}}</view></view><button class="primary" bindtap="toggleSave">{{saved ? '取消收藏' : '收藏这条资讯'}}</button><button open-type="share">分享给朋友</button><button bindtap="copyLink">复制原文链接</button><view class="meta">外部原文请复制链接后在浏览器查看。收藏仅保存在当前设备，最多100条。</view></block></view>
