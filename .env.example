# 复制为 .env 后再改。不要把填好的 .env 提交到仓库。
# 留空的项目可以保持空白。

# Web
# 设置页密码。放到公网前必填。
ADMIN_PASSWORD=
# 整站都要登录才可浏览时设为 1。默认只保护设置页。
PROTECT_SITE=0
# 会话签名。留空时第一次启动会在 DATA_DIR 里生成。
SECRET_KEY=
DATA_DIR=./data
# 可选，默认是 DATA_DIR/news.db
DATABASE_PATH=
HOST=0.0.0.0
PORT=8000
# 1 使用进程内每天定时任务；0 则改用系统 cron 调用 python -m app.cli run
SCHEDULER_ENABLED=1
LOG_LEVEL=INFO
# 单个 HTTP 请求超时（秒）
FETCH_TIMEOUT=20
# Hacker News Top 列表取多少条，Best 会再取大约一半并去重
HN_STORY_LIMIT=30

# 邮件。端口 587 通常开 SMTP_TLS；端口 465 改用 SMTP_SSL=1 且 SMTP_TLS=0。
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
SMTP_TLS=1
SMTP_SSL=0

# Server酱 SendKey，见 https://sct.ftqq.com/
SERVERCHAN_SENDKEY=

# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 企业微信群机器人的完整 Webhook
WECOM_WEBHOOK=

# 飞书自定义机器人。开了“签名校验”时再填 FEISHU_SECRET。
FEISHU_WEBHOOK=
FEISHU_SECRET=
